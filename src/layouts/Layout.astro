---
import '../styles/global.css'; import {strings,twinPath,type Lang} from '../i18n';
const {title='MimicryDB',lang='en' as Lang,description}=Astro.props;
const s=strings(lang); const langAttr=lang==='zh'?'zh-CN':'en';
const desc=description??(lang==='zh'
 ?'MimicryDB —— 一个开放数据库，记录动物、植物、真菌等类群中"模仿者 → 模型 | 接收者"的定向拟态关系。'
 :'MimicryDB — an open database of documented mimic → model | receiver interactions across animals, plants, and fungi.');
const here=Astro.url.pathname; const other=twinPath(here,lang==='zh'?'en':'zh');
---
<html lang={langAttr}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={desc}/><meta property="og:title" content={title}/><meta property="og:description" content={desc}/><meta property="og:type" content="website"/><link rel="alternate" hreflang={langAttr} href={here}/><link rel="alternate" hreflang={lang==='zh'?'en':'zh-CN'} href={other}/><title>{title}</title></head><body><a class="skip-link" href="#main">{lang==='zh'?'跳到正文':'Skip to content'}</a><header class="site-header text-white"><div class="container flex flex-wrap items-center justify-between gap-y-2 py-4"><a href={lang==='zh'?'/MimicryDB/zh/':'/MimicryDB/'} class="text-xl font-bold text-white">MimicryDB</a><nav class="flex flex-wrap gap-x-5 gap-y-2 text-sm" aria-label={lang==='zh'?'主导航':'Main navigation'}><a class="text-white" href={`/MimicryDB/${lang==='zh'?'zh/':''}interactions/`}>{s.nav.interactions}</a><a class="text-white" href={`/MimicryDB/${lang==='zh'?'zh/':''}taxa/`}>{s.nav.taxa}</a><a class="text-white" href={`/MimicryDB/${lang==='zh'?'zh/':''}mimics/`}>{s.nav.mimics}</a><a class="text-white" href={`/MimicryDB/${lang==='zh'?'zh/':''}models/`}>{s.nav.models}</a><a class="text-white" href={`/MimicryDB/${lang==='zh'?'zh/':''}references/`}>{s.nav.references}</a><a class="text-white" href={`/MimicryDB/${lang==='zh'?'zh/':''}evidence/`}>{s.nav.evidence}</a><a class="text-white" href={`/MimicryDB/${lang==='zh'?'zh/':''}search/`}>{s.nav.search}</a><a class="text-white" href={`/MimicryDB/${lang==='zh'?'zh/':''}about/`}>{s.nav.about}</a></nav><a class="text-sm text-white/80 border border-white/30 rounded-md px-2 py-1 hover:bg-white/10" href={other}>{s.footer.langToggle}</a></div></header><main id="main"><slot /></main><footer class="mt-16 border-t border-slate-200 py-8 text-sm"><div class="container flex flex-wrap items-center justify-between gap-3"><span>MimicryDB · {s.footer.tagline}</span><span><a href={`/MimicryDB/${lang==='zh'?'zh/':''}download/`}>{s.footer.download}</a> · <a href="/MimicryDB/curator/">{s.footer.curator}</a> · <a href="https://github.com/ZyYang0124/MimicryDB">GitHub ↗</a></span></div></footer></body></html>
