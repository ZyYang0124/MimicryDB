---
import Layout from '../../layouts/Layout.astro'; import {data} from '../../data/provider';
export const prerender=true; export function getStaticPaths(){return data.systems().map(s=>({params:{id:s.public_id.replace(':','-')}}));}
const sys=data.systems().find(s=>s.public_id.replace(':','-')===Astro.params.id);
const members=sys?data.interactionsForSystem(sys.public_id):[];
const taxaInvolved=sys?[...new Set(members.flatMap(m=>[m.mimic,m.model]))]:[];
const slugify=(n:string)=>n.toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,'');
const issueUrl=sys?'https://github.com/ZyYang0124/MimicryDB/issues/new?title='+encodeURIComponent(`[System ${sys.public_id}] Correction`)+'&body='+encodeURIComponent(`System: ${sys.public_id}\nPage: https://zyyang0124.github.io/MimicryDB/systems/${sys.public_id.replace(':','-')}/\n\nProblem:\n`):'#';
---
<Layout title={sys?`${sys.name} · MimicryDB`:'Not found · MimicryDB'}>{sys?<div class="container py-12"><a href="/MimicryDB/systems/">← All systems</a><p class="mt-6 text-xs uppercase tracking-[0.3em] text-slate-500">{sys.public_id} <span class="pill ml-2">{sys.system_type}</span> <span class="pill ml-2">DEMO</span></p><h1 class="mt-4 text-4xl font-bold">{sys.name}</h1><p class="mt-4 max-w-2xl leading-relaxed text-slate-300">{sys.description}</p>
<div class="card mt-6 max-w-2xl text-sm text-slate-400"><strong class="text-ink">{members.length}</strong> member interaction{members.length===1?'':'s'} · {taxaInvolved.length} taxa involved. A system is a view over atomic interactions — analyze the edges, not the grouping.</div>
<h2 class="mt-10 text-2xl font-bold">Member interactions</h2><div class="mt-6 grid gap-4">{members.map(i=><a class="card block text-ink hover:border-gold/60" href={`/MimicryDB/interactions/${i.id.replace(':','-')}/`}><div class="flex flex-wrap items-center justify-between gap-3"><div class="text-lg font-semibold"><em>{i.mimic}</em> <span class="text-coral">→</span> {i.model}</div><span class={`pill grade-${i.evidence}`}>{i.evidence}</span></div><div class="mt-2 text-sm text-slate-400">{i.id} · {i.type} · receiver: {i.receiver}</div></a>)}</div>
<h2 class="mt-10 text-2xl font-bold">Taxa involved</h2><div class="mt-4 flex flex-wrap gap-3">{taxaInvolved.map(t=><a class="btn" href={`/MimicryDB/taxa/${slugify(t)}/`}>{t}</a>)}</div>
<p class="mt-10 text-sm text-slate-400">{sys.notes}</p>
<p class="mt-6 text-xs text-slate-500"><a class="underline decoration-gold/60 hover:text-gold" href={issueUrl} target="_blank" rel="noopener">Suggest a correction ↗</a> — opens a pre-filled GitHub issue; corrections are reviewed before any change.</p></div>:<div class="container py-16"><h1 class="text-3xl font-bold">System not found</h1></div>}</Layout>
