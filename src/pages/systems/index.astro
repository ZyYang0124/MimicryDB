---
import Layout from '../../layouts/Layout.astro'; import {data} from '../../data/provider';
export const prerender=true;
const systems=data.systems();
const typeZh:Record<string,string>={ring:'穆氏环',complex:'物种复合群',polymorphic:'多态系统',series:'层级序列',other:'其它'};
---
<Layout title="Mimicry systems · MimicryDB"><div class="container py-12"><h1 class="text-4xl font-bold">Mimicry systems</h1><p class="mt-3 max-w-2xl text-slate-400">Optional grouping layer above the atomic interactions (migration 005): Müllerian rings, species complexes, polymorphic systems. The directed edge remains the only scientific record — systems are views over it.</p>
<div class="mt-8 grid gap-4">{systems.map(sys=>{const members=data.interactionsForSystem(sys.public_id);return <a class="card block text-ink hover:border-gold/60" href={`/MimicryDB/systems/${sys.public_id.replace(':','-')}/`}><div class="flex flex-wrap items-baseline justify-between gap-3"><div class="text-lg font-semibold">{sys.name}</div><span class="pill">{sys.system_type}</span></div><div class="mt-2 text-sm text-slate-400">{sys.public_id} · {members.length} member interaction{members.length===1?'':'s'} · {members.map(m=>m.id).join(', ')}</div></a>;})}</div>
<p class="mt-8 text-sm text-slate-400">{systems.length} demo system{systems.length===1?'':'s'} — synthetic grouping, labeled DEMO. No scientific claim.</p></div></Layout>
