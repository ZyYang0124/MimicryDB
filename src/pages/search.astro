---
import Layout from '../layouts/Layout.astro'; import {data} from '../data/provider';
const idx=[
 ...data.taxa().map(t=>({kind:'taxon',text:t.name,label:t.name,href:`/MimicryDB/taxa/${t.slug}/`,meta:`mimic in ${t.asMimic} · model in ${t.asModel}`})),
 ...data.all().map(i=>({kind:'interaction',text:`${i.mimic} ${i.model} ${i.id} ${i.type} ${i.receiver} ${i.summary}`,label:`${i.mimic} → ${i.model}`,href:`/MimicryDB/interactions/${i.id.replace(':','-')}/`,meta:`${i.id} · ${i.type} · ${i.evidence}`})),
 ...data.references().map(r=>({kind:'reference',text:`${r.ref.title} ${r.ref.id} ${r.ref.doi??''}`,label:r.ref.title,href:`/MimicryDB/references/${r.ref.id}/`,meta:`supports ${r.supports}`}))];
const kinds=[['taxon','Taxa'],['interaction','Interactions'],['reference','References']] as const;
---
<Layout><div class="container py-12"><h1 class="text-4xl font-bold">Search</h1><p class="mt-3">Scientific names first, then interactions (by ID or content), then references. Prototype search runs client-side over the labeled sample dataset.</p><form class="mt-6 flex gap-3" id="searchForm"><input id="q" type="search" class="card py-3 px-4 text-base w-full max-w-xl" placeholder="e.g. formicidae, MIMICRY:000002, orchid…" aria-label="Global search"/></form><div id="results" class="mt-8">{kinds.map(([kind,label])=><section class="mb-8" data-kind={kind}><h2 class="text-xl font-bold">{label}</h2><div class="mt-3 grid gap-2">{idx.filter(x=>x.kind===kind&&x.href).map(x=><a class="result card block text-ink hover:border-teal py-3" data-kind={kind} data-text={x.text.toLowerCase()} href={x.href}><span class="font-semibold">{x.label}</span><span class="block text-sm text-slate-600">{x.meta}</span></a>)}</div><p class="none hidden text-sm text-slate-600 mt-2">No matches.</p></section>)}</div></div>
<script>const q=document.getElementById('q') as HTMLInputElement;const sections=[...document.querySelectorAll('section[data-kind]')] as HTMLElement[];
function apply(){const s=q.value.trim().toLowerCase();const url=new URL(location.href);
if(s)url.searchParams.set('q',s);else url.searchParams.delete('q');history.replaceState(null,'',url);
for(const sec of sections){let n=0;for(const a of sec.querySelectorAll('.result') as NodeListOf<HTMLElement>){
const ok=!s||(a.dataset.text??'').includes(s);a.classList.toggle('hidden',!ok);if(ok)n++;}
sec.querySelector('.none')!.classList.toggle('hidden',n>0);sec.classList.toggle('hidden',n===0&&!!s);}}
q.addEventListener('input',apply);const initial=new URL(location.href).searchParams.get('q');if(initial){q.value=initial;}apply();</script>
</Layout>
