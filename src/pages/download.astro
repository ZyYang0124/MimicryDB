---
import Layout from '../layouts/Layout.astro'; import {data} from '../data/provider'; import {csv} from '../lib/csv.ts';
const interactions=data.all();
const rows=interactions.map(i=>[i.id,i.mimic,i.model,i.receiver,i.type,(i.modalities??[]).join(';'),i.knowledge??'reported',i.evidence,i.kingdoms,'DEMO']);
const file=csv(['public_id','mimic','model','receiver','type','signal_modalities','knowledge_status','evidence_grade','kingdom_flow','data_status'],rows);
const json=JSON.stringify(interactions,null,2);
---
<Layout><div class="container py-12"><h1 class="text-4xl font-bold">Download data</h1><p class="mt-4">Prototype exports of the labeled sample dataset. Scientific data licensing and release versioning will be finalized before production release (docs/RELEASE_POLICY.md).</p><div class="mt-6 flex flex-wrap gap-4"><a class="inline-block rounded-lg bg-teal px-5 py-3 font-semibold text-white" download="mimicrydb-demo.csv" href={`data:text/csv;charset=utf-8,${encodeURIComponent(file)}`}>Download CSV</a><a class="inline-block rounded-lg bg-ink px-5 py-3 font-semibold text-white" download="mimicrydb-demo.json" href={`data:application/json;charset=utf-8,${encodeURIComponent(json)}`}>Download JSON</a></div><p class="mt-6 text-sm text-slate-600">{interactions.length} records · demo data only, not a scientific release. Versioned release sets are produced by <code>npm run release:data</code> (see docs/RELEASE_POLICY.md).</p></div></Layout>
