---
import Layout from '../layouts/Layout.astro'; import {data} from '../data/provider';
const interactions=data.all();
const csv=['public_id,mimic,model,receiver,type,evidence,kingdoms',...interactions.map(i=>[i.id,i.mimic,i.model,i.receiver,i.type,i.evidence,i.kingdoms].map(v=>`"${v.replaceAll('"','""')}"`).join(','))].join('\n');
const json=JSON.stringify(interactions,null,2);
---
<Layout><div class="container py-12"><h1 class="text-4xl font-bold">Download data</h1><p class="mt-4">Prototype exports of the labeled sample dataset. Scientific data licensing and release versioning will be finalized before production release.</p><div class="mt-6 flex flex-wrap gap-4"><a class="inline-block rounded-lg bg-teal px-5 py-3 font-semibold text-white" download="mimicrydb-demo.csv" href={`data:text/csv;charset=utf-8,${encodeURIComponent(csv)}`}>Download CSV</a><a class="inline-block rounded-lg bg-ink px-5 py-3 font-semibold text-white" download="mimicrydb-demo.json" href={`data:application/json;charset=utf-8,${encodeURIComponent(json)}`}>Download JSON</a></div><p class="mt-6 text-sm text-slate-600">{interactions.length} records · demo data only, not a scientific release.</p></div></Layout>
