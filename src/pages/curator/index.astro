---
import Layout from '../../layouts/Layout.astro'; import {data} from '../../data/provider';
const cands=data.candidates(); const interactions=data.all();
const stages=[['candidate','Candidate',interactions.length],['draft','Draft',0],['needs_review','Needs review',0],['reviewed','Reviewed',0],['published','Published',0]] as const;
const pending=cands.filter(c=>c.review_status==='pending').length; const flagged=cands.filter(c=>c.review_status!=='pending').length;
const exampleRaw=JSON.stringify({model:'demo-model (placeholder)',prompt_version:'v0',confidence:0.41,fields:{mimic:'demo mimic taxon C',model:'demo model class D',grade:'E0'},note:'synthetic — not from any real publication'},null,1);
---
<Layout><div class="container py-12"><span class="pill">PROTOTYPE — NO AUTH YET</span><h1 class="mt-4 text-4xl font-bold">Curator dashboard</h1><p class="mt-3 max-w-2xl">Static demonstration of the curation workflow (docs/CURATION_GUIDE.md). In production this route sits behind Supabase Auth with curator roles; the numbers below come from the labeled demo dataset only.</p>
<div class="mt-8 grid gap-4 md:grid-cols-5">{stages.map(([k,label,n])=><div class="card"><div class="text-2xl font-bold">{n}</div><div class="text-sm text-slate-600">{label}</div></div>)}</div>
<div class="mt-10 grid gap-5 md:grid-cols-2"><div class="card"><h2 class="font-bold">Workflow</h2><p class="mt-3 text-sm">candidate → draft → needs_review → reviewed → published<br/><span class="text-slate-600">rejected · disputed · withdrawn stay internal (never public)</span></p></div><div class="card"><h2 class="font-bold">Candidate inbox</h2><p class="mt-3 text-sm">{cands.length} candidates · <strong>{pending}</strong> pending · <strong>{flagged}</strong> flagged for review. A candidate never becomes published without human curation (docs/LLM_EXTRACTION_POLICY.md).</p></div></div>
<h2 class="mt-10 text-2xl font-bold">Candidates</h2><div class="mt-4 overflow-x-auto"><table class="w-full text-left border-collapse text-sm"><thead><tr class="text-slate-600 border-b border-slate-300"><th class="py-2 pr-3">ID</th><th class="py-2 pr-3">Proposed mimic → model</th><th class="py-2 pr-3">Type</th><th class="py-2 pr-3">Grade</th><th class="py-2 pr-3">Confidence</th><th class="py-2 pr-3">Model / prompt</th><th class="py-2 pr-3">Status</th><th class="py-2">Actions</th></tr></thead><tbody>{cands.map(c=><tr class="border-b border-slate-200 align-top"><td class="py-3 pr-3 text-slate-600">{c.id}</td><td class="py-3 pr-3 font-semibold">{c.proposed_mimic} <span class="text-coral">→</span> {c.proposed_model}</td><td class="py-3 pr-3">{c.proposed_mimicry_type}</td><td class="py-3 pr-3"><span class="pill">{c.proposed_evidence_grade}</span></td><td class="py-3 pr-3">{c.extraction_confidence.toFixed(2)}</td><td class="py-3 pr-3 text-slate-600">{c.extraction_model} · {c.extraction_prompt_version}</td><td class="py-3 pr-3">{c.review_status}</td><td class="py-3"><span class="pill mr-1 opacity-50">Accept</span><span class="pill mr-1 opacity-50">Edit</span><span class="pill opacity-50">Reject</span></td></tr>)}</tbody></table></div>
<div class="card mt-8"><h2 class="font-bold">Extraction provenance (candidate CAND-DEMO-002)</h2><p class="mt-2 text-sm text-slate-600">Every candidate stores its extraction model, prompt version, timestamp, confidence and raw JSON so an extraction stays auditable and rerunnable. The raw extraction for this prototype record is a synthetic placeholder — no real publication was mined.</p><pre class="mt-3 overflow-x-auto rounded p-3 text-xs text-white" style="background:#102a43d9">{exampleRaw}</pre></div>
</div></Layout>
