---
import Layout from '../layouts/Layout.astro'; import {data,imageFor} from '../data/provider'; import {strings} from '../i18n';
import {buildNetwork,layoutNetwork,trimEdge} from '../lib/network';
const s=strings('en'); const interactions=data.all();
const hero=imageFor('Ophrys apifera'); const heroRecord=data.all().find(i=>i.mimic==='Ophrys apifera');
const net=buildNetwork(); const layout=layoutNetwork(net.nodes,net.edges);
const netIdx=new Map(net.nodes.map((n,ix)=>[n.name,ix]));
const roleFill=(r:string)=>r==='model'?'#e08b6d':r==='both'?'url(#bothg)':'#2dd4bf';
const nodeR=(n:{mimic:number;model:number})=>6+2.4*(n.mimic+n.model);
// The graph markup is emitted as a raw string: Astro's compiler cannot parse <a>
// elements with SVG children inside a <svg> template.
const graphInner=net.edges.map(e=>{
  const a=netIdx.get(e.from),b=netIdx.get(e.to); if(a===undefined||b===undefined)return '';
  const t=trimEdge(layout.pos[a].x,layout.pos[a].y,layout.pos[b].x,layout.pos[b].y,nodeR(net.nodes[a]),nodeR(net.nodes[b]));
  const cx=(t.x1+t.x2)/2-(t.y2-t.y1)*0.13,cy=(t.y1+t.y2)/2+(t.x2-t.x1)*0.13;
  return `<path d="M ${t.x1} ${t.y1} Q ${cx} ${cy} ${t.x2} ${t.y2}" fill="none" stroke="${e.crossKingdom?'#2dd4bf':'#3a3d42'}" stroke-width="${e.crossKingdom?1.8:1.4}" stroke-opacity="${e.crossKingdom?0.9:0.85}" marker-end="${e.crossKingdom?'url(#arrowt)':'url(#arrowg)'}"><title>${e.interaction}: ${e.from} → ${e.to} · ${e.type}${e.crossKingdom?' · cross-kingdom':''}</title></path>`;
}).join('')
 +net.nodes.map((n,ix)=>{
  const r=nodeR(n);const x=layout.pos[ix].x,y=layout.pos[ix].y;const above=layout.height/2>y;
  return `<a class="net-node\" href=\"/MimicryDB/taxa/${n.slug}/"><circle cx="${x}" cy="${y}" r="${r}" fill="${roleFill(n.role)}" class="cursor-pointer"><title>${n.name} — mimic in ${n.mimic}, model in ${n.model}</title></circle><text x="${x}" y="${above?y-r-7:y+r+15}" text-anchor="middle" font-size="12.5" font-style="italic" fill="#ece7dd">${n.name}</text></a>`;
}).join('');
---
<Layout title="MimicryDB — Who mimics whom across the Tree of Life?"><section class={`relative flex min-h-[88vh] items-end overflow-hidden text-white ${hero?'':'hero py-10'}`}><div class="container relative z-[2] pb-14 pt-44">
<p class="text-xs uppercase tracking-[0.4em] text-white/85 [text-shadow:0_1px_8px_rgba(0,0,0,.9)]">{s.demo}</p>
<h1 class="hasselblad-title mt-8 text-5xl md:text-6xl text-gold">MimicryDB</h1>
<h2 class="hasselblad-title mt-6 text-2xl md:text-3xl text-white/90">Who mimics whom<br/>across the Tree of Life?</h2>
<p class="mt-8 max-w-2xl text-base leading-relaxed text-white/70">{s.home.sub}</p>
<div class="mt-10 flex flex-wrap items-end justify-between gap-10"><a class="btn" href="/MimicryDB/interactions/">{s.home.explore}</a>
{hero?<figure class="max-w-sm md:text-right"><figcaption><p class="text-[0.65rem] uppercase tracking-[0.3em] text-gold">{s.home.heroPhoto.kicker}</p><p class="mt-2 font-serif text-lg italic">{s.home.heroPhoto.title}</p><p class="mt-2 text-xs leading-relaxed text-white/70">{s.home.heroPhoto.note}</p><p class="mt-3 text-[0.65rem] text-white/50">© {hero.artist}, {hero.license}, via <a class="underline" href={hero.page}>Wikimedia Commons</a> · {hero.id} · {heroRecord?<a class="underline" href={`/MimicryDB/interactions/${heroRecord.id.replace(':','-')}/`}>{s.home.heroPhoto.view}: {heroRecord.id}</a>:null}</p></figcaption></figure>:null}</div>
</div>{hero?<><img src={hero.file} alt="Ophrys apifera — the bee orchid, whose flower imitates a female bee" class="absolute inset-0 z-0 h-full w-full object-cover object-[50%_55%]"/><div class="absolute inset-0 z-[1] bg-gradient-to-t from-[#0a0a0a] via-[#0a0a0a]/45 to-black/30"/></>:null}</section>
<section class="container py-24"><p class="kicker text-center">The network</p><h2 class="mt-4 text-center text-4xl font-serif text-white">A directed network: who deceives whom</h2><p class="mx-auto mt-4 max-w-2xl text-slate-400">Every arrow runs from the <span class="font-semibold text-teal">mimic</span> to the <span class="font-semibold text-coral">model</span> it imitates. Teal arrows are cross-kingdom deceptions — a plant luring an insect, a fungus mimicking a flower. Node size grows with the number of supporting records; Hover a node to reveal its name; click it for the taxon page. Names are reconciled against the GBIF backbone.</p><div class="card mt-10 overflow-x-auto p-6"><svg viewBox={`0 0 ${layout.width} ${layout.height}`} class="w-full min-w-[760px]" role="img" aria-label="Directed mimicry network: arrows run from mimics to the models they imitate"><defs><linearGradient id="bothg" x1="0" y1="0" x2="1" y2="1"><stop offset="0.5" stop-color="#2dd4bf"/><stop offset="0.5" stop-color="#e08b6d"/></linearGradient><marker id="arrowg" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#5a5f66"/></marker><marker id="arrowt" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#2dd4bf"/></marker></defs><Fragment set:html={graphInner} /></svg></div><div class="mt-4 flex flex-wrap gap-8 text-sm text-slate-400"><span class="flex items-center gap-2"><span class="inline-block h-3 w-3 rounded-full" style="background:#2dd4bf"></span>acts as mimic ({net.nodes.filter(n=>n.role==='mimic').length})</span><span class="flex items-center gap-2"><span class="inline-block h-3 w-3 rounded-full" style="background:#e08b6d"></span>imitated as model ({net.nodes.filter(n=>n.role==='model').length})</span><span class="flex items-center gap-2"><span class="inline-block h-3 w-3 rounded-full" style="background:linear-gradient(135deg,#2dd4bf 50%,#e08b6d 50%)"></span>both ({net.nodes.filter(n=>n.role==='both').length})</span><span class="flex items-center gap-2"><span class="inline-block h-[2px] w-6" style="background:#2dd4bf"></span>cross-kingdom edge ({net.edges.filter(e=>e.crossKingdom).length})</span></div></section>
<section class="container pb-24"><div class="grid gap-5 md:grid-cols-3"><a class="card" href="/MimicryDB/interactions/"><div class="text-3xl font-bold">{interactions.length}</div><div>sample interactions</div></a><a class="card" href="/MimicryDB/models/"><div class="text-3xl font-bold">{net.nodes.filter(n=>n.model>0).length}</div><div>model taxa imitated</div></a><a class="card" href="/MimicryDB/evidence/"><div class="text-3xl font-bold">E0–E4</div><div>evidence framework</div></a></div></section></Layout>
