---
import Layout from '../layouts/Layout.astro'; import {data} from '../data/provider'; const interactions=data.all();
const H=560;const yOf=(idx:number,n:number)=>40+idx*(H-80)/Math.max(n-1,1);
const mimicsSeen:string[]=[];const modelsSeen:string[]=[];
for(const i of interactions){if(!mimicsSeen.includes(i.mimic))mimicsSeen.push(i.mimic);if(!modelsSeen.includes(i.model))modelsSeen.push(i.model);}
const L=mimicsSeen.map((m,idx)=>({name:m,x:190,y:yOf(idx,mimicsSeen.length),n:interactions.filter(i=>i.mimic===m).length}));
const R=modelsSeen.map((m,idx)=>({name:m,x:610,y:yOf(idx,modelsSeen.length),n:interactions.filter(i=>i.model===m).length}));
const edges=interactions.map(i=>({i,from:L[mimicsSeen.indexOf(i.mimic)],to:R[modelsSeen.indexOf(i.model)],cross:i.kingdoms.split(' → ')[0]!==i.kingdoms.split(' → ')[1]}));
---
<Layout title="MimicryDB"><section class="bg-ink py-20 text-white"><div class="container"><span class="pill">DEMO / PROTOTYPE DATA</span><h1 class="mt-5 text-5xl font-bold">Who mimics whom<br/>across the Tree of Life?</h1><p class="mt-5 max-w-2xl text-lg text-slate-200">An open database of documented mimic–model interactions across animals, plants, fungi, and other lineages.</p><a class="mt-8 inline-block rounded-lg bg-coral px-5 py-3 font-semibold text-white" href="/MimicryDB/interactions/">Explore interactions →</a></div></section><section class="container py-14"><div class="grid gap-5 md:grid-cols-3"><div class="card"><div class="text-3xl font-bold">{interactions.length}</div><div>sample interactions</div></div><div class="card"><div class="text-3xl font-bold">{new Set(interactions.map(x=>x.mimic)).size}</div><div>mimic taxa</div></div><a class="card block text-ink hover:border-teal" href="/MimicryDB/evidence/"><div class="text-3xl font-bold">E0–E4</div><div>evidence framework →</div></a></div><h2 class="mt-14 text-3xl font-bold">Mimic → Model</h2><p class="mt-3 max-w-2xl">The fundamental record is a directional biological interaction, linked to references and evidence provenance. Publication, interaction, taxon pair, and evolutionary origin remain distinct.</p><div class="card mt-8 overflow-x-auto"><svg viewBox="0 0 800 600" class="min-w-[640px] w-full" role="img" aria-label="Directed mimic → model network of the sample dataset"><defs><marker id="arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#d97757"/></marker></defs><text x="190" y="20" text-anchor="middle" class="fill-slate-600" font-size="13">Mimics</text><text x="610" y="20" text-anchor="middle" class="fill-slate-600" font-size="13">Models</text>{edges.map(e=><line x1={e.from.x} y1={e.from.y} x2={e.to.x} y2={e.to.y} stroke={e.cross?'#0f766e':'#d97757'} stroke-opacity="0.45" stroke-width="1.5" marker-end="url(#arr)"><title>{`${e.i.mimic} → ${e.i.model} · ${e.i.type} · ${e.i.evidence}`}</title></line>)}{L.map(n=><g><circle cx={n.x} cy={n.y} r={6+3*n.n} fill="#102a43"><title>{`${n.name} — mimic in ${n.n} record(s)`}</title></circle><text x={n.x-14} y={n.y+4} text-anchor="end" font-size="12" class="fill-ink">{n.name}</text></g>)}{R.map(n=><g><circle cx={n.x} cy={n.y} r={6+3*n.n} fill="#0f766e"><title>{`${n.name} — model in ${n.n} record(s)`}</title></circle><text x={n.x+16} y={n.y+4} text-anchor="start" font-size="12" class="fill-ink">{n.name}</text></g>)}</svg></div><p class="mt-2 text-sm text-slate-600">Node size = number of sample records; teal edges are cross-kingdom interactions. A Tree-of-Life visualization is planned but deliberately not faked.</p></section></Layout>
