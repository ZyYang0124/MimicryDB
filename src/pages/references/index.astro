---
import Layout from '../../layouts/Layout.astro'; import {data} from '../../data/provider';
const refs=data.references().sort((a,b)=>b.supports-a.supports);
---
<Layout><div class="container py-12"><span class="pill">DEMO / PROTOTYPE DATA</span><h1 class="mt-4 text-4xl font-bold">References</h1><p class="mt-3">Sources supporting MimicryDB interactions. The current rows are demo placeholders — no real citation metadata exists yet, and none will be fabricated.</p><div class="mt-8 grid gap-3">{refs.map(r=><a class="card block text-ink hover:border-gold/60" href={`/MimicryDB/references/${r.ref.id}/`}><div class="flex flex-wrap items-center justify-between gap-3"><span class="font-semibold">{r.ref.title}</span><span class="pill">supports {r.supports}</span></div><div class="mt-2 text-sm text-slate-400">{r.ref.id}{r.ref.doi?` · DOI ${r.ref.doi}`:''}{r.ref.year?` · ${r.ref.year}`:''}</div></a>)}</div></div></Layout>
