---
import Layout from '../../layouts/Layout.astro'; import {data} from '../../data/provider';
export const prerender=true; export function getStaticPaths(){return data.references().map(r=>({params:{id:r.ref.id}}));}
const r=data.references().find(x=>x.ref.id===Astro.params.id); const supported=r?data.interactionsForRef(r.ref.id):[];
---
<Layout>{r?<div class="container py-12"><a href="/MimicryDB/references/">← All references</a><h1 class="mt-6 text-3xl font-bold">{r.ref.title}</h1><p class="mt-3 text-slate-600">{r.ref.id}{r.ref.doi?` · DOI: ${r.ref.doi}`:''}{r.ref.authors?` · ${r.ref.authors}`:''}{r.ref.year?` · ${r.ref.year}`:''}{r.ref.journal?` · ${r.ref.journal}`:''}</p><div class="card mt-6 inline-block text-sm text-slate-600">This publication supports <strong class="text-ink">{r.supports}</strong> MimicryDB interaction{r.supports===1?'':'s'}.</div><h2 class="mt-10 text-2xl font-bold">Supported interactions</h2><div class="mt-6 grid gap-4">{supported.map(i=><a class="card block text-ink hover:border-teal" href={`/MimicryDB/interactions/${i.id.replace(':','-')}/`}><div class="flex flex-wrap items-center justify-between gap-3"><div class="text-lg font-semibold">{i.mimic} <span class="text-coral">→</span> {i.model}</div><span class="pill grade-{i.evidence}"></span></div><div class="mt-2 text-sm text-slate-600">{i.id} · {i.type} · {i.kingdoms}</div></a>)}</div><p class="mt-8 text-sm text-slate-600">Demo placeholder reference — sample data, not a real publication.</p></div>:<div class="container py-16"><h1 class="text-3xl font-bold">Reference not found</h1></div>}</Layout>
