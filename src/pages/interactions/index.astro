---
import Layout from '../../layouts/Layout.astro'; import {data} from '../../data/provider';
const interactions=data.all(); const types=[...new Set(interactions.map(i=>i.type))].sort(); const grades=[...new Set(interactions.map(i=>i.evidence))].sort();
---
<Layout><div class="container py-12"><span class="pill">DEMO / PROTOTYPE DATA</span><h1 class="mt-4 text-4xl font-bold">Explore interactions</h1><p class="mt-3">Directional records: Mimic → Model | Receiver</p><div class="mt-6 flex flex-wrap gap-3"><input id="q" type="search" class="card py-2 px-3 text-sm w-72" placeholder="Search taxa, type or summary…" aria-label="Search interactions"/><select id="type" class="card py-2 px-3 text-sm" aria-label="Filter by type"><option value="">All types</option>{types.map(t=><option value={t}>{t}</option>)}</select><select id="grade" class="card py-2 px-3 text-sm" aria-label="Filter by evidence grade"><option value="">All evidence grades</option>{grades.map(g=><option value={g}>{g}</option>)}</select></div><div id="list" class="mt-8 grid gap-4">{interactions.map(i=><a class="card block text-ink hover:border-teal interaction-card" data-type={i.type} data-grade={i.evidence} data-text={`${i.mimic} ${i.model} ${i.receiver} ${i.type} ${i.summary}`.toLowerCase()} href={`/MimicryDB/interactions/${i.id.replace(':','-')}/`}><div class="flex flex-wrap items-center justify-between gap-3"><div class="text-xl font-semibold">{i.mimic} <span class="text-coral">→</span> {i.model}</div><span class="pill">{i.evidence}</span></div><div class="mt-3 text-sm text-slate-600">{i.type} · receiver: {i.receiver} · {i.kingdoms}</div><p class="mt-3">{i.summary}</p></a>)}</div><p id="empty" class="mt-8 hidden text-slate-600">No interactions match the current filters.</p></div>
<script>const $=(id:string)=>document.getElementById(id)!;const q=$('q') as HTMLInputElement;const ty=$('type') as HTMLSelectElement;const g=$('grade') as HTMLSelectElement;const cards=[...document.querySelectorAll('.interaction-card')] as HTMLElement[];
function apply(){const s=q.value.toLowerCase();let n=0;
for(const c of cards){const ok=(!ty.value||c.dataset.type===ty.value)&&(!g.value||c.dataset.grade===g.value)&&(!s||(c.dataset.text??'').includes(s));c.classList.toggle('hidden',!ok);if(ok)n++;}
$('empty').classList.toggle('hidden',n>0);}
for(const el of [q,ty,g])el.addEventListener('input',apply);</script>
</Layout>
