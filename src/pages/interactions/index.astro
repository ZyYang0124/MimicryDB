---
import Layout from '../../layouts/Layout.astro'; import {data,imageFor} from '../../data/provider'; import {strings} from '../../i18n';
const s=strings('en');
const interactions=data.all(); const types=[...new Set(interactions.map(i=>i.type))].sort(); const grades=[...new Set(interactions.map(i=>i.evidence))].sort();
const kinds=[...new Set(interactions.map(i=>i.modelKind??'organism'))];
---
<Layout title="Explore interactions · MimicryDB"><div class="container py-16"><p class="kicker">{s.demo}</p><h1 class="mt-4 text-4xl font-serif text-white">Explore interactions</h1><p class="mt-3 text-slate-400">Directional records: Mimic → Model | Receiver. Filters persist in the URL.</p><div class="mt-8 flex flex-wrap gap-3"><input id="q" type="search" class="card py-2 px-3 text-sm w-72" placeholder="Search taxa, type or summary…" aria-label="Search interactions"/><select id="type" class="card py-2 px-3 text-sm" aria-label="Filter by type"><option value="">All types</option>{types.map(t=><option value={t}>{t}</option>)}</select><select id="grade" class="card py-2 px-3 text-sm" aria-label="Filter by evidence grade"><option value="">All evidence grades</option>{grades.map(g=><option value={g}>{g}</option>)}</select><select id="mkind" class="card py-2 px-3 text-sm" aria-label="Filter by model kind"><option value="">All model kinds</option>{kinds.map(k=><option value={k}>{k}</option>)}</select></div>
<div class="mt-12 grid gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">{interactions.map(i=>{const img=imageFor(i.mimic)??imageFor(i.model);return <a class="interaction-card group block" data-type={i.type} data-grade={i.evidence} data-mkind={i.modelKind??'organism'} data-text={`${i.mimic} ${i.model} ${i.receiver} ${i.type} ${i.summary}`.toLowerCase()} href={`/MimicryDB/interactions/${i.id.replace(':','-')}/`}>
<div class="aspect-[4/5] overflow-hidden bg-mist">{img?<img src={img.file} alt={i.mimic} class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.05]"/>:<div class="flex h-full items-center justify-center font-serif text-8xl italic text-white/10">M</div>}</div>
<div class="mt-5 flex items-center justify-between gap-3"><span class="kicker">{i.id}</span><span class={`pill grade-${i.evidence}`}>{i.evidence}</span></div>
<div class="mt-3 font-serif text-xl text-white"><em>{i.mimic}</em> <span class="text-coral">→</span> {i.model}{i.modelKind&&i.modelKind!=='organism'?<span class={`pill ml-2 kind-${i.modelKind}`}>{i.modelKind}</span>:null}</div>
<div class="mt-1 text-sm text-slate-400">{i.type} · {i.kingdoms}</div>
</a>;})}</div>
<p id="empty" class="mt-12 hidden text-slate-400">No interactions match the current filters.</p><p class="mt-6 text-sm text-slate-500">Showing <span id="count"></span> of {interactions.length} sample records.</p></div>
<script>const $=(id:string)=>document.getElementById(id)!;const q=$('q') as HTMLInputElement;const ty=$('type') as HTMLSelectElement;const g=$('grade') as HTMLSelectElement;const mk=$('mkind') as HTMLSelectElement;
const cards=[...document.querySelectorAll('.interaction-card')] as HTMLElement[];
function syncUrl(){const p=new URLSearchParams();if(q.value)p.set('q',q.value);if(ty.value)p.set('type',ty.value);if(g.value)p.set('grade',g.value);if(mk.value)p.set('mkind',mk.value);if(p.toString())history.replaceState(null,'',`${location.pathname}?${p}`);else history.replaceState(null,'',location.pathname);}
function apply(){const s=q.value.toLowerCase();let n=0;
for(const c of cards){const ok=(!ty.value||c.dataset.type===ty.value)&&(!g.value||c.dataset.grade===g.value)&&(!mk.value||c.dataset.mkind===mk.value)&&(!s||(c.dataset.text??'').includes(s));c.classList.toggle('hidden',!ok);if(ok)n++;}
$('empty').classList.toggle('hidden',n>0);$('count').textContent=String(n);syncUrl();}
for(const el of [q,ty,g,mk])el.addEventListener('input',apply);
const p=new URLSearchParams(location.search);if(p.get('q'))q.value=p.get('q')!;if(p.get('type'))ty.value=p.get('type')!;if(p.get('grade'))g.value=p.get('grade')!;if(p.get('mkind'))mk.value=p.get('mkind')!;
apply();</script>
</Layout>
