---
import Layout from '../../layouts/Layout.astro'; import {data,slugify} from '../../data/provider';
const interactions=data.all(); const types=[...new Set(interactions.map(i=>i.type))].sort(); const grades=[...new Set(interactions.map(i=>i.evidence))].sort();
const kindLabels:Record<string,string>={organism:'物种模型 · organism',environment:'环境 · environment',object:'无生命对象 · object',self:'自身 · self',unknown:'未知',other:'其它'};
const kinds=[...new Set(interactions.map(i=>i.modelKind??'organism'))];
const cols=[['id','ID'],['mimic','Mimic'],['model','Model'],['type','Type'],['evidence','Evidence'],['kingdoms','Kingdoms']] as const;
---
<Layout><div class="container py-12"><span class="pill">DEMO / PROTOTYPE DATA</span><h1 class="mt-4 text-4xl font-bold">Explore interactions</h1><p class="mt-3">Directional records: Mimic → Model | Receiver. Click a column header to sort; filters and sorting persist in the URL.</p><div class="mt-6 flex flex-wrap gap-3"><input id="q" type="search" class="card py-2 px-3 text-sm w-72" placeholder="Search taxa, type or summary…" aria-label="Search interactions"/><select id="type" class="card py-2 px-3 text-sm" aria-label="Filter by type"><option value="">All types</option>{types.map(t=><option value={t}>{t}</option>)}</select><select id="grade" class="card py-2 px-3 text-sm" aria-label="Filter by evidence grade"><option value="">All evidence grades</option>{grades.map(g=><option value={g}>{g}</option>)}</select><select id="mkind" class="card py-2 px-3 text-sm" aria-label="Filter by model kind"><option value="">All model kinds</option>{kinds.map(k=><option value={k}>{kindLabels[k]??k}</option>)}</select><select id="xking" class="card py-2 px-3 text-sm" aria-label="Cross-kingdom only"><option value="">All records</option><option value="1">Cross-kingdom only</option></select></div><div class="mt-6 overflow-x-auto"><table class="w-full text-left border-collapse" id="table"><thead><tr class="text-sm text-slate-600 border-b border-slate-300">{cols.map(([k,label])=><th class="py-2 pr-4"><button class="sort-btn font-semibold hover:text-teal" data-col={k} aria-label={`Sort by ${label}`}>{label} <span class="arrow" data-for={k}></span></button></th>)}</tr></thead><tbody id="rows">{interactions.map(i=><tr class="interaction-row border-b border-slate-200" data-id={i.id} data-mimic={i.mimic} data-model={i.model} data-type={i.type} data-grade={i.evidence} data-kingdoms={i.kingdoms} data-xking={i.kingdoms.split(' → ')[0]!==i.kingdoms.split(' → ')[1]&&(!i.modelKind||i.modelKind==='organism')?'1':'0'} data-mkind={i.modelKind??'organism'} data-text={`${i.mimic} ${i.model} ${i.receiver} ${i.type} ${i.summary}`.toLowerCase()}>
<td class="py-3 pr-4 text-sm text-slate-600"><a class="hover:underline" href={`/MimicryDB/interactions/${i.id.replace(':','-')}/`}>{i.id}</a></td>
<td class="py-3 pr-4 font-semibold"><a class="hover:underline" href={`/MimicryDB/taxa/${slugify(i.mimic)}/`}>{i.mimic}</a></td>
<td class="py-3 pr-4 font-semibold"><a class="hover:underline" href={`/MimicryDB/taxa/${slugify(i.model)}/`}>{i.model}</a>{i.modelKind&&i.modelKind!=='organism'?<span class="pill ml-2">{i.modelKind}</span>:null}</td>
<td class="py-3 pr-4 text-sm">{i.type}</td>
<td class="py-3 pr-4"><span class="pill grade-{i.evidence}"></span></td>
<td class="py-3 pr-4 text-sm text-slate-600">{i.kingdoms}</td></tr>)}</tbody></table></div><p id="empty" class="mt-8 hidden text-slate-600">No interactions match the current filters.</p><p class="mt-4 text-sm text-slate-600">Showing <span id="count"></span> of {interactions.length} sample records. Pagination will be introduced with the live database backend.</p></div>
<script>const $=(id:string)=>document.getElementById(id)!;const q=$('q') as HTMLInputElement;const ty=$('type') as HTMLSelectElement;const g=$('grade') as HTMLSelectElement;const mk=$('mkind') as HTMLSelectElement;const xk=$('xking') as HTMLSelectElement;
const rows=[...document.querySelectorAll('.interaction-row')] as HTMLElement[];const btns=[...document.querySelectorAll('.sort-btn')] as HTMLButtonElement[];
let sortCol='id',sortDir=1;const sortable=['id','mimic','model','type','evidence','kingdoms'];
function syncUrl(){const p=new URLSearchParams();if(q.value)p.set('q',q.value);if(ty.value)p.set('type',ty.value);if(g.value)p.set('grade',g.value);if(mk.value)p.set('mkind',mk.value);if(xk.value)p.set('xking','1');p.set('sort',sortCol);if(sortDir<0)p.set('dir','-1');history.replaceState(null,'',`${location.pathname}?${p}`);}
function apply(){const s=q.value.toLowerCase();let n=0;
for(const r of rows){const ok=(!ty.value||r.dataset.type===ty.value)&&(!g.value||r.dataset.grade===g.value)&&(!mk.value||r.dataset.mkind===mk.value)&&(!xk.value||r.dataset.xking==='1')&&(!s||(r.dataset.text??'').includes(s));r.classList.toggle('hidden',!ok);if(ok)n++;}
$('empty').classList.toggle('hidden',n>0);$('count').textContent=String(n);
const sorted=[...rows].sort((a,b)=>((a.dataset[sortCol as 'id']??'').localeCompare(b.dataset[sortCol as 'id']??''))*sortDir);
for(const r of sorted)$('rows').appendChild(r);
for(const b of btns){const a=b.querySelector('.arrow')!;a.textContent=b.dataset.col===sortCol?(sortDir>0?'↑':'↓'):'';}
syncUrl();}
for(const el of [q,ty,g,mk,xk])el.addEventListener('input',apply);
for(const b of btns)b.addEventListener('click',()=>{const c=b.dataset.col!;if(sortCol===c)sortDir*=-1;else{sortCol=c;sortDir=1;}apply();});
const p=new URLSearchParams(location.search);if(p.get('q'))q.value=p.get('q')!;if(p.get('type'))ty.value=p.get('type')!;if(p.get('grade'))g.value=p.get('grade')!;if(p.get('mkind'))mk.value=p.get('mkind')!;if(p.get('xking'))xk.value='1';
const sp=p.get('sort');if(sp&&sortable.includes(sp))sortCol=sp;if(p.get('dir')==='-1')sortDir=-1;
apply();</script>
</Layout>
