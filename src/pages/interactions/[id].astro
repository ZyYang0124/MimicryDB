---
import Layout from '../../layouts/Layout.astro'; import {interactions} from '../../data/demo'; export const prerender=true; export function getStaticPaths(){return interactions.map(i=>({params:{id:i.id.replace(':','-')}}));} const i=interactions.find(x=>x.id.replace(':','-')===Astro.params.id);
---
<Layout>{i?<div class="container py-12"><a href="/MimicryDB/interactions/">← All interactions</a><h1 class="mt-6 text-4xl font-bold">{i.mimic} <span class="text-coral">→</span> {i.model}</h1><div class="mt-6 grid gap-5 md:grid-cols-2"><div class="card"><h2 class="font-bold">Scientific summary</h2><p class="mt-3">{i.summary}</p><p class="mt-4"><strong>Receiver:</strong> {i.receiver}<br/><strong>Type:</strong> {i.type}<br/><strong>Evidence:</strong> <span class="pill">{i.evidence}</span></p></div><div class="card"><h2 class="font-bold">Provenance</h2><p class="mt-3">{i.reference}</p><p class="mt-4 text-sm text-slate-600">This sample record is explicitly labeled demo data and is not a published scientific claim.</p></div></div></div>:<div class="container py-16"><h1 class="text-3xl font-bold">Interaction not found</h1></div>}</Layout>
