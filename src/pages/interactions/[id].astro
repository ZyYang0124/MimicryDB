---
import Layout from '../../layouts/Layout.astro'; import {data,slugify} from '../../data/provider';
export const prerender=true; export function getStaticPaths(){return data.all().map(i=>({params:{id:i.id.replace(':','-')}}));}
const i=data.byId(Astro.params.id??''); const refs=i?data.refsFor(i.id):[];
---
<Layout>{i?<div class="container py-12"><a href="/MimicryDB/interactions/">← All interactions</a><h1 class="mt-6 text-4xl font-bold"><a class="hover:underline" href={`/MimicryDB/taxa/${slugify(i.mimic)}/`}>{i.mimic}</a> <span class="text-coral">→</span> <a class="hover:underline" href={`/MimicryDB/taxa/${slugify(i.model)}/`}>{i.model}</a></h1><p class="mt-2 text-sm text-slate-600">{i.id} · {i.kingdoms} · model kind: {i.modelKind??'organism'} · knowledge status: {i.knowledge??'reported'} <span class="pill ml-2">DEMO</span></p><div class="mt-6 grid gap-5 md:grid-cols-2"><div class="card"><h2 class="font-bold">Scientific summary</h2><p class="mt-3">{i.summary}</p><p class="mt-4"><strong>Receiver:</strong> {i.receiver}<br/><strong>Type:</strong> {i.type}<br/><strong>Evidence:</strong> <a class="inline-block" href="/MimicryDB/evidence/"><span class="pill">{i.evidence}</span></a></p>{i.modalities?.length?<p class="mt-4"><strong>Signal modalities:</strong>{i.modalities.map(m=><span class="pill mr-2 ml-1">{m}</span>)}</p>:null}</div><div class="card"><h2 class="font-bold">Provenance</h2><p class="mt-3">{i.reference}</p>{refs.length?<ul class="mt-3 list-disc pl-5 text-sm">{refs.map(r=><li><a class="hover:underline" href={`/MimicryDB/references/${r.id}/`}>{r.title}</a></li>)}</ul>:null}<p class="mt-4 text-sm text-slate-600">This sample record is explicitly labeled demo data and is not a published scientific claim.</p></div></div>
<h2 class="mt-10 text-2xl font-bold">Related records</h2><div class="mt-4 grid gap-4 md:grid-cols-2">{data.all().filter(x=>x.id!==i.id&&(x.mimic===i.mimic||x.model===i.model||x.type===i.type)).slice(0,4).map(x=><a class="card block text-ink hover:border-teal" href={`/MimicryDB/interactions/${x.id.replace(':','-')}/`}><div class="text-lg font-semibold">{x.mimic} <span class="text-coral">→</span> {x.model}</div><div class="mt-2 text-sm text-slate-600">{x.type} · {x.evidence}</div></a>)}</div></div>:<div class="container py-16"><h1 class="text-3xl font-bold">Interaction not found</h1></div>}</Layout>
