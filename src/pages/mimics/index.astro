---
import Layout from '../../layouts/Layout.astro'; import {data} from '../../data/provider';
import StatBars from '../../components/StatBars.astro';
const all=data.all(); const gradeRank=(g:string)=>+(g[1]??0);
const mimics=data.taxa().filter(t=>t.asMimic>0).sort((a,b)=>b.asMimic-a.asMimic)
  .map(t=>({...t,models:new Set(all.filter(i=>i.mimic===t.name).map(i=>i.model)).size,best:'E'+Math.max(...all.filter(i=>i.mimic===t.name).map(i=>gradeRank(i.evidence)))}));
---
<Layout><div class="container py-12"><span class="pill">DEMO / PROTOTYPE DATA</span><h1 class="mt-4 text-4xl font-bold">Mimics</h1><p class="mt-3">Taxa that most frequently act as mimics in the sample dataset, with model diversity.</p><StatBars kicker="Most frequent mimics" items={[...mimics].sort((a,b)=>b.asMimic-a.asMimic).slice(0,8).map(t=>({label:t.name,value:t.asMimic}))} />
<div class="mt-10 flex flex-wrap gap-3 items-center"><label class="text-sm" for="minGrade">Minimum best evidence grade</label><select id="minGrade" class="card py-2 px-3 text-sm" aria-label="Filter mimics by minimum best evidence grade"><option value="0">any (E0+)</option><option value="1">E1+</option><option value="2">E2+</option><option value="3">E3+</option><option value="4">E4 only</option></select></div><table class="mt-6 w-full text-left border-collapse"><thead><tr class="text-sm text-slate-400 border-b border-white/20"><th class="py-2">Mimic taxon</th><th class="py-2">Interactions</th><th class="py-2">Distinct models</th><th class="py-2">Lineages</th><th class="py-2">Best evidence</th></tr></thead><tbody id="rows">{mimics.map(t=><tr class="mimic-row border-b border-white/10" data-best={t.best[1]}><td class="py-3 font-semibold"><a class="hover:underline" href={`/MimicryDB/taxa/${t.slug}/`}>{t.name}</a></td><td class="py-3">{t.asMimic}</td><td class="py-3">{t.models}</td><td class="py-3 text-sm text-slate-400">{t.lineages}</td><td class="py-3"><span class={`pill grade-${t.best}`}></span></td></tr>)}</tbody></table><p id="empty" class="mt-6 hidden text-slate-400">No mimics match this evidence threshold yet.</p></div>
<script>const sel=document.getElementById('minGrade') as HTMLSelectElement;const rows=[...document.querySelectorAll('.mimic-row')] as HTMLElement[];
function apply(){const min=+sel.value;let n=0;for(const r of rows){const ok=+(r.dataset.best??0)>=min;r.classList.toggle('hidden',!ok);if(ok)n++;}document.getElementById('empty')!.classList.toggle('hidden',n>0);}
sel.addEventListener('change',apply);</script>
</Layout>
