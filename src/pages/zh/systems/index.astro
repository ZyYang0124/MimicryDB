---
import Layout from '../../../layouts/Layout.astro'; import {data} from '../../../data/provider';
export const prerender=true;
const systems=data.systems();
---
<Layout lang="zh" title="拟态系统 · MimicryDB"><div class="container py-12"><h1 class="text-4xl font-bold">拟态系统</h1><p class="mt-3 max-w-2xl text-slate-400">原子交互之上的可选分组层（迁移 005）：穆氏环、物种复合群、多态系统。有向边始终是唯一的科学记录——系统只是边之上的视图。</p>
<div class="mt-8 grid gap-4">{systems.map(sys=>{const members=data.interactionsForSystem(sys.public_id);return <a class="card block text-ink hover:border-gold/60" href={`/MimicryDB/zh/systems/${sys.public_id.replace(':','-')}/`}><div class="flex flex-wrap items-baseline justify-between gap-3"><div class="text-lg font-semibold">{sys.name}</div><span class="pill">{sys.system_type}</span></div><div class="mt-2 text-sm text-slate-400">{sys.public_id} · {members.length} 条成员交互 · {members.map(m=>m.id).join('，')}</div></a>;})}</div>
<p class="mt-8 text-sm text-slate-400">{systems.length} 个演示系统——合成分组，已标注 DEMO，不构成科学结论。</p></div></Layout>
