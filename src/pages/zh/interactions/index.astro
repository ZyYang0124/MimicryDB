---
import Layout from '../../../layouts/Layout.astro'; import {data,slugify} from '../../../data/provider'; import {summaryZh} from '../../../data/demo'; import {strings} from '../../../i18n';
const s=strings('zh');
const summaryZhOf=(id:string)=>summaryZh[id]??'';
const interactions=data.all(); const types=[...new Set(interactions.map(i=>i.type))].sort(); const grades=[...new Set(interactions.map(i=>i.evidence))].sort();
const kinds=[...new Set(interactions.map(i=>i.modelKind??'organism'))];
const kindZh:Record<string,string>={organism:'物种',environment:'环境',object:'无生命对象',self:'自身',unknown:'未知',other:'其它'};
const cols=[['id','编号'],['mimic','模仿者'],['model','模型'],['type','类型'],['evidence','证据'],['kingdoms','界']] as const;
---
<Layout lang="zh" title="交互记录 · MimicryDB"><div class="container py-12"><span class="pill">{s.demo}</span><h1 class="mt-4 text-4xl font-bold">浏览交互记录</h1><p class="mt-3">定向记录：模仿者 → 模型 | 接收者。点击列标题排序；筛选与排序会保存在网址中。</p><div class="mt-6 flex flex-wrap gap-3"><input id="q" type="search" class="card py-2 px-3 text-sm w-72" placeholder="搜索类群、类型或摘要…" aria-label="搜索交互记录"/><select id="type" class="card py-2 px-3 text-sm" aria-label="按类型筛选"><option value="">全部类型</option>{types.map(t=><option value={t}>{t}</option>)}</select><select id="grade" class="card py-2 px-3 text-sm" aria-label="按证据等级筛选"><option value="">全部证据等级</option>{grades.map(g=><option value={g}>{g}</option>)}</select><select id="mkind" class="card py-2 px-3 text-sm" aria-label="按模型类别筛选"><option value="">全部模型类别</option>{kinds.map(k=><option value={k}>{kindZh[k]??k}</option>)}</select></div><div class="mt-6 overflow-x-auto"><table class="data w-full text-left border-collapse" id="table"><thead><tr>{cols.map(([k,label])=><th class="py-2 pr-4"><button class="sort-btn font-semibold hover:text-teal" data-col={k} aria-label={`按${label}排序`}>{label} <span class="arrow" data-for={k}></span></button></th>)}</tr></thead><tbody id="rows">{interactions.map(i=><tr class="interaction-row" data-id={i.id} data-mimic={i.mimic} data-model={i.model} data-type={i.type} data-grade={i.evidence} data-kingdoms={i.kingdoms} data-mkind={i.modelKind??'organism'} data-xking={i.kingdoms.split(' → ')[0]!==i.kingdoms.split(' → ')[1]&&(!i.modelKind||i.modelKind==='organism')?'1':'0'} data-text={`${i.mimic} ${i.model} ${i.receiver} ${i.type} ${i.summary} ${summaryZhOf(i.id)}`.toLowerCase()}>
<td class="py-3 pr-4 text-sm text-slate-600"><a class="hover:underline mono" href={`/MimicryDB/interactions/${i.id.replace(':','-')}/`}>{i.id}</a></td>
<td class="py-3 pr-4 font-semibold"><a class="hover:underline" href={`/MimicryDB/taxa/${slugify(i.mimic)}/`}>{i.mimic}</a></td>
<td class="py-3 pr-4 font-semibold"><a class="hover:underline" href={`/MimicryDB/taxa/${slugify(i.model)}/`}>{i.model}</a>{i.modelKind&&i.modelKind!=='organism'?<span class={`pill ml-2 kind-${i.modelKind}`}>{kindZh[i.modelKind]??i.modelKind}</span>:null}</td>
<td class="py-3 pr-4 text-sm">{i.type}</td>
<td class="py-3 pr-4"><span class={`pill grade-${i.evidence}`}>{i.evidence}</span></td>
<td class="py-3 pr-4 text-sm text-slate-600">{i.kingdoms}</td></tr>)}</tbody></table></div><p id="empty" class="mt-8 hidden text-slate-600">没有符合当前筛选条件的记录。</p><p class="mt-4 text-sm text-slate-600">显示 <span id="count"></span> / {interactions.length} 条演示记录。分页将在线上数据库接入后引入。</p></div>
<script>const $=(id:string)=>document.getElementById(id)!;const q=$('q') as HTMLInputElement;const ty=$('type') as HTMLSelectElement;const g=$('grade') as HTMLSelectElement;const mk=$('mkind') as HTMLSelectElement;
const rows=[...document.querySelectorAll('.interaction-row')] as HTMLElement[];const btns=[...document.querySelectorAll('.sort-btn')] as HTMLButtonElement[];
let sortCol='id',sortDir=1;const sortable=['id','mimic','model','type','evidence','kingdoms'];
function syncUrl(){const p=new URLSearchParams();if(q.value)p.set('q',q.value);if(ty.value)p.set('type',ty.value);if(g.value)p.set('grade',g.value);if(mk.value)p.set('mkind',mk.value);p.set('sort',sortCol);if(sortDir<0)p.set('dir','-1');history.replaceState(null,'',`${location.pathname}?${p}`);}
function apply(){const s=q.value.toLowerCase();let n=0;
for(const r of rows){const ok=(!ty.value||r.dataset.type===ty.value)&&(!g.value||r.dataset.grade===g.value)&&(!mk.value||r.dataset.mkind===mk.value)&&(!s||(r.dataset.text??'').includes(s));r.classList.toggle('hidden',!ok);if(ok)n++;}
$('empty').classList.toggle('hidden',n>0);$('count').textContent=String(n);
const sorted=[...rows].sort((a,b)=>((a.dataset[sortCol as 'id']??'').localeCompare(b.dataset[sortCol as 'id']??''))*sortDir);
for(const r of sorted)$('rows').appendChild(r);
for(const b of btns){const a=b.querySelector('.arrow')!;a.textContent=b.dataset.col===sortCol?(sortDir>0?'↑':'↓'):'';}
syncUrl();}
for(const el of [q,ty,g,mk])el.addEventListener('input',apply);
for(const b of btns)b.addEventListener('click',()=>{const c=b.dataset.col!;if(sortCol===c)sortDir*=-1;else{sortCol=c;sortDir=1;}apply();});
const p=new URLSearchParams(location.search);if(p.get('q'))q.value=p.get('q')!;if(p.get('type'))ty.value=p.get('type')!;if(p.get('grade'))g.value=p.get('grade')!;if(p.get('mkind'))mk.value=p.get('mkind')!;
const sp=p.get('sort');if(sp&&sortable.includes(sp))sortCol=sp;if(p.get('dir')==='-1')sortDir=-1;
apply();</script>
</Layout>
