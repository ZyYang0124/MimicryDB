---
import Layout from '../../../layouts/Layout.astro'; import {data,slugify} from '../../../data/provider'; import {summaryZh} from '../../../data/demo'; import {strings} from '../../../i18n';
const s=strings('zh');
export const prerender=true; export function getStaticPaths(){return data.all().map(i=>({params:{id:i.id.replace(':','-')}}));}
const i=data.byId(Astro.params.id??''); const refs=i?data.refsFor(i.id):[];
const kindZh=(k?:string)=>({organism:'物种',environment:'环境',object:'无生命对象',self:'自身',unknown:'未知',other:'其它'}[k??'organism']??k??'物种');
const modZh=(m:string)=>({visual:'视觉',morphological:'形态',colour:'颜色',pattern:'斑纹',behavioural:'行为',locomotor:'运动',acoustic:'声学',chemical:'化学',olfactory:'嗅觉',tactile:'触觉',vibrational:'振动',multimodal:'多模态',unknown:'未知',other:'其它'}[m]??m);
---
<Layout lang="zh" title={`${i?`${i.mimic} → ${i.model}`:'未找到'} · MimicryDB`}>{i?<div class="container py-12"><a href="/MimicryDB/zh/interactions/">← 全部交互记录</a><h1 class="mt-6 text-4xl font-bold"><a class="hover:underline" href={`/MimicryDB/zh/taxa/${slugify(i.mimic)}/`}>{i.mimic}</a> <span class="text-coral">→</span> <a class="hover:underline" href={`/MimicryDB/zh/taxa/${slugify(i.model)}/`}>{i.model}</a></h1><p class="mt-2 text-sm text-slate-600">{i.id} · {i.kingdoms} · 模型类别：{kindZh(i.modelKind)} · 知识状态：{i.knowledge??'reported'} <span class="pill ml-2">DEMO</span></p><div class="mt-6 grid gap-5 md:grid-cols-2"><div class="card"><h2 class="font-bold">科学摘要</h2><p class="mt-3">{summaryZh[i.id]??i.summary}</p>{summaryZh[i.id]?<p class="mt-2 text-xs text-slate-500">English: {i.summary}</p>:null}<p class="mt-4"><strong>接收者：</strong>{i.receiver}<br/><strong>类型：</strong>{i.type}<br/><strong>证据：</strong><a class="inline-block" href="/MimicryDB/zh/evidence/"><span class={`pill grade-${i.evidence}`}>{i.evidence}</span></a></p>{i.modalities?.length?<p class="mt-4"><strong>信号模态：</strong>{i.modalities.map(m=><span class="pill mr-2 ml-1">{modZh(m)}</span>)}</p>:null}</div><div class="card"><h2 class="font-bold">文献溯源</h2><p class="mt-3">{i.reference}</p>{refs.length?<ul class="mt-3 list-disc pl-5 text-sm">{refs.map(r=><li><a class="hover:underline" href={`/MimicryDB/zh/references/${r.id}/`}>{r.title}</a></li>)}</ul>:null}<p class="mt-4 text-sm text-slate-600">本样例记录明确标注为演示数据，不构成已发表的科学结论。</p></div></div>
<h2 class="mt-10 text-2xl font-bold">相关记录</h2><div class="mt-4 grid gap-4 md:grid-cols-2">{data.all().filter(x=>x.id!==i.id&&(x.mimic===i.mimic||x.model===i.model||x.type===i.type)).slice(0,4).map(x=><a class="card block text-ink hover:border-teal" href={`/MimicryDB/zh/interactions/${x.id.replace(':','-')}/`}><div class="text-lg font-semibold">{x.mimic} <span class="text-coral">→</span> {x.model}</div><div class="mt-2 text-sm text-slate-600">{x.type} · {x.evidence}</div></a>)}</div></div>:<div class="container py-16"><h1 class="text-3xl font-bold">未找到该交互记录</h1></div>}</Layout>
