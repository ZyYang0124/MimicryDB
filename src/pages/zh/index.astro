---
import Layout from '../../layouts/Layout.astro'; import {data} from '../../data/provider'; import {summaryZh} from '../../data/demo'; import {strings} from '../../i18n';
const s=strings('zh'); const interactions=data.all();
const H=560;const yOf=(idx:number,n:number)=>40+idx*(H-80)/Math.max(n-1,1);
const mimicsSeen:string[]=[];const modelsSeen:string[]=[];
for(const i of interactions){if(!mimicsSeen.includes(i.mimic))mimicsSeen.push(i.mimic);if(!modelsSeen.includes(i.model))modelsSeen.push(i.model);}
const L=mimicsSeen.map((m,idx)=>({name:m,x:190,y:yOf(idx,mimicsSeen.length),n:interactions.filter(i=>i.mimic===m).length}));
const R=modelsSeen.map((m,idx)=>({name:m,x:610,y:yOf(idx,modelsSeen.length),n:interactions.filter(i=>i.model===m).length}));
const edges=interactions.map(i=>({i,from:L[mimicsSeen.indexOf(i.mimic)],to:R[modelsSeen.indexOf(i.model)],cross:i.kingdoms.split(' → ')[0]!==i.kingdoms.split(' → ')[1]}));
const kindZh=(k?:string)=>({organism:'物种',environment:'环境',object:'无生命对象',self:'自身',unknown:'未知',other:'其它'}[k??'organism']??k);
---
<Layout lang="zh" title="MimicryDB · 谁在模仿谁？"><section class="bg-ink hero py-20 text-white"><div class="container"><span class="pill">{s.demo}</span><h1 class="mt-5 text-5xl font-bold font-serif">{s.home.h1}</h1><p class="mt-5 max-w-2xl text-lg text-slate-200">{s.home.sub}</p><div class="mt-8"><a class="btn btn-coral" href="/MimicryDB/zh/interactions/">{s.home.explore}</a></div><div class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-sm text-slate-200"><a href="/MimicryDB/zh/taxa/">{s.home.quick[0]}</a><a href="/MimicryDB/zh/mimics/">{s.home.quick[1]}</a><a href="/MimicryDB/zh/models/">{s.home.quick[2]}</a><a href="/MimicryDB/zh/references/">{s.home.quick[3]}</a><a href="/MimicryDB/zh/download/">{s.home.quick[4]}</a><a href="/MimicryDB/zh/about/">{s.home.quick[5]}</a></div></div></section><section class="container py-14"><div class="grid gap-5 md:grid-cols-3"><div class="card"><div class="text-3xl font-bold">{interactions.length}</div><div>条演示交互记录</div></div><div class="card"><div class="text-3xl font-bold">{new Set(interactions.map(x=>x.mimic)).size}</div><div>个模仿者分类单元</div></div><div class="card"><div class="text-3xl font-bold">E0–E4</div><div>证据分级框架</div></div></div><h2 class="mt-14 text-3xl font-bold">{s.home.netTitle}</h2><p class="mt-3 max-w-2xl">数据库的基本记录是一条有方向的生物学交互，并链接到文献与证据溯源。发表物、交互、分类单元组合与演化起源始终保持彼此独立。</p><div class="card mt-8 overflow-x-auto"><svg viewBox="0 0 800 600" class="min-w-[640px] w-full" role="img" aria-label="演示数据集的模仿者 → 模型有向网络"><defs><marker id="arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#d97757"/></marker></defs><text x="190" y="20" text-anchor="middle" class="fill-slate-600" font-size="13">模仿者</text><text x="610" y="20" text-anchor="middle" class="fill-slate-600" font-size="13">模型</text>{edges.map(e=><line x1={e.from.x} y1={e.from.y} x2={e.to.x} y2={e.to.y} stroke={e.cross?'#0f766e':'#d97757'} stroke-opacity="0.45" stroke-width="1.5" marker-end="url(#arr)"><title>{`${e.i.mimic} → ${e.i.model} · ${e.i.type} · ${e.i.evidence}`}</title></line>)}{L.map(n=><g><circle cx={n.x} cy={n.y} r={6+3*n.n} fill="#13293d"><title>{`${n.name} — 作为模仿者出现 ${n.n} 次`}</title></circle><text x={n.x-14} y={n.y+4} text-anchor="end" font-size="12" class="fill-ink">{n.name}</text></g>)}{R.map(n=><g><circle cx={n.x} cy={n.y} r={6+3*n.n} fill="#0f766e"><title>{`${n.name} — 作为模型出现 ${n.n} 次`}</title></circle><text x={n.x+16} y={n.y+4} text-anchor="start" font-size="12" class="fill-ink">{n.name}</text></g>)}</svg></div><p class="mt-2 text-sm text-slate-600">{s.home.netNote}</p></section></Layout>
