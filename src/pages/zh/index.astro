---
import Layout from '../../layouts/Layout.astro'; import {data,imageFor} from '../../data/provider'; import {strings} from '../../i18n';
import {buildTree,layoutTree,treeRoles,treeStats} from '../../lib/tree';
const s=strings('zh'); const interactions=data.all();
const hero=imageFor('Ophrys apifera'); const heroRecord=data.byId('MIMICRY:000002');
const tree=buildTree(); const layout=layoutTree(tree);
const stats=treeStats(tree);
const px=(x:number)=>40+x*110; const py=(y:number)=>y+30;
const rankZh:Record<string,string>={root:'生命',kingdom:'界',phylum:'门',class:'纲',order:'目',family:'科',genus:'属',taxon:'类群'};
const nodeLabel=(n:{name:string;leaf:string|null;rank:string})=>n.leaf?n.name:(rankZh[n.rank]??n.rank);
---
<Layout lang="zh" title="MimicryDB · 谁在模仿谁？"><section class={`relative flex min-h-[88vh] items-end overflow-hidden text-white ${hero?'':'hero py-10'}`}><div class="container relative z-[2] pb-14 pt-44">
<p class="text-xs uppercase tracking-[0.4em] text-white/85 [text-shadow:0_1px_8px_rgba(0,0,0,.9)]">{s.demo}</p>
<h1 class="hasselblad-title mt-8 text-5xl md:text-6xl text-gold">MimicryDB</h1>
<h2 class="mt-8 text-2xl md:text-3xl font-serif text-white/90">谁在模仿谁？——横跨生命之树</h2>
<p class="mt-8 max-w-2xl text-base leading-relaxed text-white/70">{s.home.sub}</p>
<div class="mt-10 flex flex-wrap items-end justify-between gap-10"><a class="btn" href="/MimicryDB/zh/interactions/">{s.home.explore}</a>
{hero?<figure class="max-w-sm md:text-right"><figcaption><p class="text-[0.65rem] uppercase tracking-[0.3em] text-gold">{s.home.heroPhoto.kicker}</p><p class="mt-2 font-serif text-lg italic">{s.home.heroPhoto.title}</p><p class="mt-2 text-xs leading-relaxed text-white/70">{s.home.heroPhoto.note}</p><p class="mt-3 text-[0.65rem] text-white/50">© {hero.artist}，{hero.license}，来自 <a class="underline" href={hero.page}>Wikimedia Commons</a> · {hero.id} · {heroRecord?<a class="underline" href={`/MimicryDB/zh/interactions/${heroRecord.id.replace(':','-')}/`}>{s.home.heroPhoto.view}：{heroRecord.id}</a>:null}</p></figcaption></figure>:null}</div>
</div>{hero?<><img src={hero.file} alt="蜂兰——一朵模仿雌蜂的兰花" class="absolute inset-0 z-0 h-full w-full object-cover object-[50%_38%]"/><div class="absolute inset-0 z-[1] bg-gradient-to-t from-[#0a0a0a] via-[#0a0a0a]/45 to-black/30"/></>:null}</section>
<section class="container py-24"><p class="kicker text-center">分布地图</p><h2 class="mt-4 text-center text-4xl font-serif text-white">生命之树上的拟态分布</h2><p class="mt-4 max-w-2xl text-slate-400">层级结构来自 GBIF 名录。<span class="font-semibold text-teal">青色</span>类群充当模仿者；<span class="font-semibold text-coral">橙色</span>类群被模仿；深色节点兼具两职。节点大小随样本记录数变化。描述性模型（如"鸟粪"）按设计不入树，单独记录。</p><div class="card mt-10 overflow-x-auto p-6"><svg viewBox={`0 0 ${layout.width} ${layout.height}`} class="w-full min-w-[760px]" role="img" aria-label="生命之树：模仿者与模型的分布">{layout.links.map(l=><path d={`M ${px(l.x1)} ${py(l.y1)} H ${px(l.x1)+40} V ${py(l.y2)} H ${px(l.x2)-6}`} fill="none" stroke="#2a2a2a" stroke-width="1.5"/>)}
{layout.nodes.map(({node,x,y})=>{const role=treeRoles(node);const r=node.leaf?4+2*(node.mimic+node.model):3+Math.min(node.taxa,6);return <g>
{(node.mimic>0&&node.model>0&&node.leaf)?<circle cx={px(x)} cy={py(y)} r={r+2.5} fill="none" stroke="#e08b6d" stroke-width="1.6"/>:null}
<circle cx={px(x)} cy={py(y)} r={r} fill={node.leaf?(role==='model'?'#e08b6d':role==='both'?'#ece7dd':'#2dd4bf'):'#3a3d42'}><title>{`${rankZh[node.rank]??node.rank}：${node.name}${node.leaf?` — 模仿者 ${node.mimic} 次，模型 ${node.model} 次`:''}`}</title></circle>
<text x={node.leaf?px(x)+r+6:px(x)-r-6} y={py(y)+4} text-anchor={node.leaf?'start':'end'} font-size={node.leaf?12:11} font-style={node.leaf?'italic':'normal'} class={node.leaf?'fill-ink':'fill-slate-500'}>{nodeLabel(node)}</text></g>;})}</svg></div><div class="mt-4 flex flex-wrap gap-8 text-sm text-slate-400"><span class="flex items-center gap-2"><span class="inline-block h-3 w-3 rounded-full" style="background:#2dd4bf"></span>充当模仿者（{stats.mimicTaxa}）</span><span class="flex items-center gap-2"><span class="inline-block h-3 w-3 rounded-full" style="background:#e08b6d"></span>被模仿的模型（{stats.modelTaxa}）</span><span class="flex items-center gap-2"><span class="inline-block h-3 w-3 rounded-full" style="background:#ece7dd"></span>两者兼具</span></div></section>
<section class="container pb-24"><div class="grid gap-5 md:grid-cols-3"><a class="card" href="/MimicryDB/zh/interactions/"><div class="text-3xl font-bold">{interactions.length}</div><div>条演示交互记录</div></a><a class="card" href="/MimicryDB/zh/models/"><div class="text-3xl font-bold">{stats.modelTaxa}</div><div>个被模仿的模型类群</div></a><a class="card" href="/MimicryDB/zh/evidence/"><div class="text-3xl font-bold">E0–E4</div><div>证据分级框架</div></a></div></section></Layout>
