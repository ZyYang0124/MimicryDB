---
import Layout from '../../../layouts/Layout.astro'; import {data} from '../../../data/provider'; import {strings} from '../../../i18n';
const s=strings('zh');
import StatBars from '../../../components/StatBars.astro';
const all=data.all(); const gradeRank=(g:string)=>+(g[1]??0);
const mimics=data.taxa().filter(t=>t.asMimic>0).sort((a,b)=>b.asMimic-a.asMimic)
  .map(t=>({...t,models:new Set(all.filter(i=>i.mimic===t.name).map(i=>i.model)).size,best:'E'+Math.max(...all.filter(i=>i.mimic===t.name).map(i=>gradeRank(i.evidence)))}));
---
<Layout lang="zh" title="模仿者排行 · MimicryDB"><div class="container py-12"><span class="pill">{s.demo}</span><h1 class="mt-4 text-4xl font-bold">模仿者</h1><p class="mt-3">演示数据集中最常作为模仿者的类群，含模型多样性统计。</p><StatBars kicker="最活跃的模仿者" items={[...mimics].sort((a,b)=>b.asMimic-a.asMimic).slice(0,8).map(t=>({label:t.name,value:t.asMimic}))} />
<div class="mt-10 flex flex-wrap gap-3 items-center"><label class="text-sm" for="minGrade">最低最佳证据等级</label><select id="minGrade" class="card py-2 px-3 text-sm" aria-label="按最低最佳证据等级筛选"><option value="0">不限（E0+）</option><option value="1">E1+</option><option value="2">E2+</option><option value="3">E3+</option><option value="4">仅 E4</option></select></div><table class="data mt-6 w-full text-left border-collapse"><thead><tr><th class="py-2">模仿者</th><th class="py-2">交互数</th><th class="py-2">不同模型数</th><th class="py-2">世系</th><th class="py-2">最佳证据</th></tr></thead><tbody id="rows">{mimics.map(t=><tr class="mimic-row" data-best={t.best[1]}><td class="py-3 font-semibold"><a class="hover:underline" href={`/MimicryDB/zh/taxa/${t.slug}/`}>{t.name}</a></td><td class="py-3">{t.asMimic}</td><td class="py-3">{t.models}</td><td class="py-3 text-sm text-slate-400">{t.lineages}</td><td class="py-3"><span class={`pill grade-${t.best}`}>{t.best}</span></td></tr>)}</tbody></table><p id="empty" class="mt-6 hidden text-slate-400">该证据阈值下暂无符合条件的模仿者。</p></div>
<script>const sel=document.getElementById('minGrade') as HTMLSelectElement;const rows=[...document.querySelectorAll('.mimic-row')] as HTMLElement[];
function apply(){const min=+sel.value;let n=0;for(const r of rows){const ok=+(r.dataset.best??0)>=min;r.classList.toggle('hidden',!ok);if(ok)n++;}document.getElementById('empty')!.classList.toggle('hidden',n>0);}
sel.addEventListener('change',apply);</script>
</Layout>
