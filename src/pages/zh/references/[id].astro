---
import Layout from '../../../layouts/Layout.astro'; import {data} from '../../../data/provider'; 
export const prerender=true; export function getStaticPaths(){return data.references().map(r=>({params:{id:r.ref.id}}));}
const r=data.references().find(x=>x.ref.id===Astro.params.id); const supported=r?data.interactionsForRef(r.ref.id):[];
---
<Layout lang="zh" title={`${r?.ref.title??'未找到'} · MimicryDB`}>{r?<div class="container py-12"><a href="/MimicryDB/zh/references/">← 全部文献</a><h1 class="mt-6 text-3xl font-bold">{r.ref.title}</h1><p class="mt-3 text-slate-600">{r.ref.id}{r.ref.doi?` · DOI: ${r.ref.doi}`:''}</p><div class="card mt-6 inline-block text-sm text-slate-600">该文献支持 MimicryDB 的 <strong class="text-ink">{r.supports}</strong> 条交互记录。</div><h2 class="mt-10 text-2xl font-bold">所支持的交互记录</h2><div class="mt-6 grid gap-4">{supported.map(i=><a class="card block text-ink hover:border-teal" href={`/MimicryDB/zh/interactions/${i.id.replace(':','-')}/`}><div class="flex flex-wrap items-center justify-between gap-3"><div class="text-lg font-semibold">{i.mimic} <span class="text-coral">→</span> {i.model}</div><span class={`pill grade-${i.evidence}`}>{i.evidence}</span></div><div class="mt-2 text-sm text-slate-600">{i.id} · {i.type} · {i.kingdoms}</div></a>)}</div><p class="mt-8 text-sm text-slate-600">演示占位文献——样例数据，不是真实出版物。</p></div>:<div class="container py-16"><h1 class="text-3xl font-bold">未找到该文献</h1></div>}</Layout>
