---
import Layout from '../../../layouts/Layout.astro'; import {data} from '../../../data/provider'; import {strings} from '../../../i18n'; 
export const prerender=true; export function getStaticPaths(){return data.references().map(r=>({params:{id:r.ref.id}}));}
const s=strings('zh');
const r=data.references().find(x=>x.ref.id===Astro.params.id); const supported=r?data.interactionsForRef(r.ref.id):[];
const taxa=[...new Set(supported.flatMap(i=>[i.mimic,i.model]))];
---
<Layout lang="zh" title={`${r?.ref.title??'未找到'} · MimicryDB`}>{r?<div class="container py-12"><a href="/MimicryDB/zh/references/">← 全部文献</a><h1 class="mt-6 text-3xl font-bold">{r.ref.title}</h1><p class="mt-3 text-slate-400">{r.ref.id}{r.ref.doi?` · DOI: ${r.ref.doi}`:''}</p><div class="card mt-6 inline-block text-sm text-slate-400">该文献支持 MimicryDB 的 <strong class="text-ink">{r.supports}</strong> 条交互记录。</div>{r.ref.claims?.length?<p class="mt-3 flex flex-wrap items-center gap-2 text-[0.65rem] uppercase tracking-[0.18em] text-slate-500"><span>{s.common.supports}</span>{r.ref.claims.map(c=><span class={`pill claim-${c}`}>{s.claims[c]??c}</span>)}</p>:null}<div class="mt-6 grid gap-4 md:grid-cols-2"><div class="card"><h2 class="text-xs uppercase tracking-[0.25em] text-slate-500">涉及的类群</h2><p class="mt-3 text-sm text-slate-400">共 {taxa.length} 个</p><p class="mt-1 flex flex-wrap gap-x-3 gap-y-1 text-sm text-slate-300">{taxa.map(x=><em>{x}</em>)}</p></div><div class="card"><h2 class="text-xs uppercase tracking-[0.25em] text-slate-500">拟态类型</h2><p class="mt-3 text-sm text-slate-300">{[...new Set(supported.map(i=>i.type))].join(' · ')}</p></div></div>
<h2 class="mt-10 text-2xl font-bold">所支持的交互记录</h2><div class="mt-6 grid gap-4">{supported.map(i=><a class="card block text-ink hover:border-gold/60" href={`/MimicryDB/zh/interactions/${i.id.replace(':','-')}/`}><div class="flex flex-wrap items-center justify-between gap-3"><div class="text-lg font-semibold">{i.mimic} <span class="text-coral">→</span> {i.model}</div><span class={`pill grade-${i.evidence}`}>{i.evidence}</span></div><div class="mt-2 text-sm text-slate-400">{i.id} · {i.type} · {i.kingdoms}</div></a>)}</div><p class="mt-8 text-sm text-slate-400">演示占位文献——样例数据，不是真实出版物。正式版此页还将列出逐段证据记录与抽取溯源；迁移 005 的 Crossref 字段为文献块供数。</p></div>:<div class="container py-16"><h1 class="text-3xl font-bold">未找到该文献</h1></div>}</Layout>
