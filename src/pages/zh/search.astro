---
import Layout from '../../layouts/Layout.astro'; import {data} from '../../data/provider';
import vocab from '../../../data/controlled-vocabularies.json';
const interactions=data.all().map(i=>({id:i.id,mimic:i.mimic,model:i.model,receiver:i.receiver,type:i.type,
  evidence:i.evidence,kingdoms:i.kingdoms,modelKind:i.modelKind??'organism',modalities:i.modalities??[],
  summary:i.summary,href:`/MimicryDB/zh/interactions/${i.id.replace(':','-')}/`}));
const kZh:Record<string,string>=({visual:'视觉',chemical:'化学',acoustic:'声学',morphological:'形态',colour:'颜色',pattern:'斑纹',behavioural:'行为',locomotor:'运动',olfactory:'嗅觉',tactile:'触觉',vibrational:'振动',multimodal:'多模态',unknown:'未知',other:'其它',organism:'物种',environment:'环境',object:'无生命对象',self:'自身'});
const facets={
  type:[...new Set(interactions.map(i=>i.type))].sort(),
  modality:vocab.signal_modality.map(t=>t.term).filter(m=>interactions.some(i=>i.modalities?.includes(m))),
  evidence:['E4','E3','E2','E1','E0'],
  modelKind:vocab.model_kind.map(t=>t.term),
  kingdom:[...new Set(interactions.flatMap(i=>i.kingdoms.split(' → ').map(k=>k.trim())))].sort(),
};
const island=JSON.stringify({interactions,facets}).replace(/<\/script/gi,'<\\/script');
const sel='bg-transparent border border-white/25 rounded-sm px-2 py-1.5 text-xs text-white focus:border-gold outline-none';
const lab='block text-[0.65rem] uppercase tracking-[0.2em] text-slate-500 mb-2';
---
<Layout lang="zh" title="分面搜索 · MimicryDB"><div class="container py-12"><h1 class="text-4xl font-bold">分面搜索</h1>
<p class="mt-3 max-w-2xl text-slate-400">对原子交互做多面 AND 组合筛选——查看、导出精确匹配的切片。关键词覆盖名称、编号、接收者与摘要。</p>

<div class="mt-8 grid gap-6 md:grid-cols-3 lg:grid-cols-6">
<div><label class={lab} for="fq">关键词</label><input id="fq" type="search" placeholder="蚂蚁、兰花…" class={sel+' w-full'}/></div>
<div><label class={lab} for="ftype">拟态类型</label><select id="ftype" class={sel+' w-full'}><option value="">全部</option>{facets.type.map(t=><option value={t}>{t}</option>)}</select></div>
<div><label class={lab} for="fmod">信号模态</label><select id="fmod" class={sel+' w-full'}><option value="">全部</option>{facets.modality.map(t=><option value={t}>{kZh[t]??t}</option>)}</select></div>
<div><label class={lab} for="fev">最低证据</label><select id="fev" class={sel+' w-full'}><option value="0">不限</option><option value="1">E1+</option><option value="2">E2+</option><option value="3">E3+</option><option value="4">E4</option></select></div>
<div><label class={lab} for="fmk">模型一侧</label><select id="fmk" class={sel+' w-full'}><option value="">全部</option>{facets.modelKind.map(t=><option value={t}>{kZh[t]??t}</option>)}</select></div>
<div><label class={lab} for="fkg">所在界</label><select id="fkg" class={sel+' w-full'}><option value="">全部</option>{facets.kingdom.map(t=><option value={t}>{t}</option>)}</select></div>
</div>
<p class="mt-6 text-sm"><span id="count" class="font-semibold text-gold"></span> <button id="reset" class="ml-4 text-xs text-slate-400 underline">重置</button></p>
<div class="mt-3 overflow-x-auto"><table class="data w-full"><thead><tr><th>记录</th><th>模仿者 → 模型</th><th>类型</th><th>证据</th><th>界流向</th></tr></thead><tbody id="rows"></tbody></table></div>
<div class="mt-6"><a id="dl" class="btn" download="mimicrydb-search-results.csv" href="#">下载这些结果 ↓ CSV</a></div>
</div>
<script type="application/json" id="sdata" set:html={island}/><script>
const {interactions,facets}=JSON.parse(document.getElementById('sdata')!.textContent??'{}') as {interactions:any[];facets:any};
const $=(id:string)=>document.getElementById(id) as HTMLInputElement|HTMLSelectElement|HTMLAnchorElement|HTMLElement;
const els={q:$('fq') as HTMLInputElement,type:$('ftype') as HTMLSelectElement,mod:$('fmod') as HTMLSelectElement,ev:$('fev') as HTMLSelectElement,mk:$('fmk') as HTMLSelectElement,kg:$('fkg') as HTMLSelectElement};
const rows=$('rows') as HTMLTableSectionElement; const count=$('count') as HTMLElement; const dl=$('dl') as HTMLAnchorElement;
const esc=(v:string|null|undefined)=>(v??'').replace(/&/g,'&amp;').replace(/</g,'&lt;');
const csvEsc=(v:string)=>/[",\n]/.test(v)?'"'+v.replace(/"/g,'""')+'"':v;
function hit(i:any):boolean{
  const t=(els.q.value||'').trim().toLowerCase();
  const okq=!t||[i.id,i.mimic,i.model,i.receiver,i.type,i.summary].join(' ').toLowerCase().includes(t);
  const [mk,dk]=i.kingdoms.split(' → ').map((x:string)=>x.trim());
  return okq&&(!els.type.value||i.type===els.type.value)
    &&(!els.mod.value||i.modalities.includes(els.mod.value))
    &&(+(i.evidence[1]??0)>=+(els.ev.value||0))
    &&(!els.mk.value||i.modelKind===els.mk.value)
    &&(!els.kg.value||mk===els.kg.value||dk===els.kg.value);
}
function apply(){
  const f=interactions.filter(hit);
  count.textContent=`${f.length} / ${interactions.length} 条交互符合`;
  rows.innerHTML=f.map((i:any)=>`<tr><td class="mono text-xs"><a class="underline" href="${i.href}">${esc(i.id)}</a></td><td><em>${esc(i.mimic)}</em> <span class="text-coral">→</span> ${esc(i.model)}</td><td class="text-sm text-slate-400">${esc(i.type)}</td><td><span class="pill grade-${i.evidence}">${i.evidence}</span></td><td class="text-sm text-slate-400">${esc(i.kingdoms)}</td></tr>`).join('');
  const header='public_id,mimic,model,receiver,type,signal_modalities,evidence_grade,kingdom_flow,model_kind,mimicry_summary,data_status';
  const csv=header+'\n'+f.map((i:any)=>[i.id,i.mimic,i.model,i.receiver,i.type,i.modalities.join(';'),i.evidence,i.kingdoms,i.modelKind,i.summary,'DEMO'].map(csvEsc).join(',')).join('\n');
  dl.href='data:text/csv;charset=utf-8,'+encodeURIComponent(csv);
  const url=new URL(location.href);
  for(const [k,el] of Object.entries(els)){const v=(el as HTMLInputElement).value;if(v)url.searchParams.set(k,v);else url.searchParams.delete(k);}
  history.replaceState(null,'',url);
}
for(const el of Object.values(els)){el.addEventListener('input',apply);el.addEventListener('change',apply);}
$('reset').addEventListener('click',()=>{for(const el of Object.values(els))(el as HTMLInputElement).value='';apply();});
const p=new URL(location.href).searchParams;
for(const [k,el] of Object.entries(els)){const v=p.get(k);if(v)(el as HTMLInputElement).value=v;}
apply();
</script></Layout>
