---
import Layout from '../../../layouts/Layout.astro'; import {data} from '../../../data/provider'; import {strings} from '../../../i18n';
const s=strings('zh');
const all=data.all(); const gradeRank=(g:string)=>+(g[1]??0);
const models=data.taxa().filter(t=>t.asModel>0).sort((a,b)=>b.asModel-a.asModel)
  .map(t=>({...t,mimics:new Set(all.filter(i=>i.model===t.name).map(i=>i.mimic)).size,best:'E'+Math.max(...all.filter(i=>i.model===t.name).map(i=>gradeRank(i.evidence)))}));
---
<Layout lang="zh" title="模型排行 · MimicryDB"><div class="container py-12"><span class="pill">{s.demo}</span><h1 class="mt-4 text-4xl font-bold">模型</h1><p class="mt-3">最常被模仿的类群（含物种模型、环境与无生命对象——通过"模型类别"区分）。排名仅基于演示数据集。</p><div class="mt-6 flex flex-wrap gap-3 items-center"><label class="text-sm" for="minGrade">最低最佳证据等级</label><select id="minGrade" class="card py-2 px-3 text-sm" aria-label="按最低最佳证据等级筛选"><option value="0">不限（E0+）</option><option value="1">E1+</option><option value="2">E2+</option><option value="3">E3+</option><option value="4">仅 E4</option></select></div><table class="data mt-6 w-full text-left border-collapse"><thead><tr><th class="py-2">模型</th><th class="py-2">交互数</th><th class="py-2">不同模仿者数</th><th class="py-2">世系</th><th class="py-2">最佳证据</th></tr></thead><tbody id="rows">{models.map(t=><tr class="model-row" data-best={t.best[1]}><td class="py-3 font-semibold"><a class="hover:underline" href={`/MimicryDB/zh/taxa/${t.slug}/`}>{t.name}</a></td><td class="py-3">{t.asModel}</td><td class="py-3">{t.mimics}</td><td class="py-3 text-sm text-slate-400">{t.lineages}</td><td class="py-3"><span class={`pill grade-${t.best}`}>{t.best}</span></td></tr>)}</tbody></table><p id="empty" class="mt-6 hidden text-slate-400">该证据阈值下暂无符合条件的模型。</p></div>
<script>const sel=document.getElementById('minGrade') as HTMLSelectElement;const rows=[...document.querySelectorAll('.model-row')] as HTMLElement[];
function apply(){const min=+sel.value;let n=0;for(const r of rows){const ok=+(r.dataset.best??0)>=min;r.classList.toggle('hidden',!ok);if(ok)n++;}document.getElementById('empty')!.classList.toggle('hidden',n>0);}
sel.addEventListener('change',apply);</script>
</Layout>
