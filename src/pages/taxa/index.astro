---
import Layout from '../../layouts/Layout.astro'; import {data} from '../../data/provider';
import StatBars from '../../components/StatBars.astro';
const taxa=data.taxa();
const lineageCount=new Map<string,number>();
for(const t of taxa)for(const l of t.lineages.split(' · '))lineageCount.set(l,(lineageCount.get(l)??0)+1);
const lineageBars=[...lineageCount].map(([label,value])=>({label,value})).sort((a,b)=>b.value-a.value);
---
<Layout><div class="container py-12"><h1 class="text-4xl font-bold">Taxa</h1><p class="mt-3">Mimics and models represented in the prototype dataset.</p><StatBars kicker="By lineage" items={lineageBars} />
<div class="mt-10 grid gap-3 md:grid-cols-3">{taxa.map(t=><a class="card block text-ink hover:border-gold/60" href={`/MimicryDB/taxa/${t.slug}/`}><div class="flex items-baseline justify-between gap-2"><span class="text-lg font-semibold">{t.name}</span><span class="pill">{t.lineages}</span></div><div class="mt-2 text-sm text-slate-400">mimic in {t.asMimic} · model in {t.asModel}</div></a>)}</div></div></Layout>
