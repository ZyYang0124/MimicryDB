---
import Layout from '../../layouts/Layout.astro'; import {interactions} from '../../data/demo'; const taxa=[...new Set(interactions.flatMap(i=>[i.mimic,i.model]))];
---
<Layout><div class="container py-12"><h1 class="text-4xl font-bold">Taxa</h1><p class="mt-3">Mimics and models represented in the prototype dataset.</p><div class="mt-8 grid gap-3 md:grid-cols-3">{taxa.map(t=><div class="card">{t}</div>)}</div></div></Layout>
