---
import Layout from '../../layouts/Layout.astro'; import {data} from '../../data/provider';
export const prerender=true; export function getStaticPaths(){return data.taxa().map(t=>({params:{name:t.slug}}));}
const t=data.taxa().find(x=>x.slug===Astro.params.name); const related=t?data.all().filter(i=>i.mimic===t.name||i.model===t.name):[];
---
<Layout>{t?<div class="container py-12"><a href="/MimicryDB/taxa/">← All taxa</a><h1 class="mt-6 text-4xl font-bold italic">{t.name}</h1><p class="mt-3">Lineage{t.lineages.includes(' · ')?'s':''}: {t.lineages} · mimic in {t.asMimic} record{t.asMimic===1?'':'s'} · model in {t.asModel} record{t.asModel===1?'':'s'}</p><h2 class="mt-10 text-2xl font-bold">Interactions</h2><div class="mt-6 grid gap-4">{related.map(i=><a class="card block text-ink hover:border-teal" href={`/MimicryDB/interactions/${i.id.replace(':','-')}/`}><div class="flex flex-wrap items-center justify-between gap-3"><div class="text-lg font-semibold">{i.mimic} <span class="text-coral">→</span> {i.model}</div><span class="pill">{i.evidence}</span></div><div class="mt-2 text-sm text-slate-600">{i.id} · {i.type} · receiver: {i.receiver}</div></a>)}</div><p class="mt-8 text-sm text-slate-600">Prototype data — names are used as written in the sample records and are not yet resolved against a taxonomic backbone.</p></div>:<div class="container py-16"><h1 class="text-3xl font-bold">Taxon not found</h1></div>}</Layout>
