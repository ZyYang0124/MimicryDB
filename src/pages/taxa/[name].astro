---
import Layout from '../../layouts/Layout.astro'; import {data,gbifFor} from '../../data/provider';
export const prerender=true; export function getStaticPaths(){return data.taxa().map(t=>({params:{name:t.slug}}));}
const t=data.taxa().find(x=>x.slug===Astro.params.name); const related=t?data.all().filter(i=>i.mimic===t.name||i.model===t.name):[];
const g=t?gbifFor(t.name):undefined;
---
<Layout>{t?<div class="container py-12"><a href="/MimicryDB/taxa/">← All taxa</a><h1 class="mt-6 text-4xl font-bold italic">{t.name}</h1><p class="mt-3">Lineage{t.lineages.includes(' · ')?'s':''}: {t.lineages} · mimic in {t.asMimic} record{t.asMimic===1?'':'s'} · model in {t.asModel} record{t.asModel===1?'':'s'}</p>
{g&&g.matchType==='NOT_A_SCIENTIFIC_NAME'?<div class="card mt-5 text-sm text-slate-600">Descriptive or functional model class — not reconciled against a taxonomic backbone; curation required to resolve it.</div>:g&&g.gbif_usageKey?<div class="card mt-5 text-sm"><strong>GBIF backbone:</strong> <span class="pill">{g.matchType}</span>{g.gbif_canonical&&g.gbif_canonical!==t.name?<span> · accepted as <em>{g.gbif_canonical}</em></span>:null}{g.gbif_kingdom?<span> · {g.gbif_kingdom}</span>:null}{g.confidence?<span> · confidence {g.confidence}</span>:null} · <a class="hover:underline" href={`https://www.gbif.org/species/${g.gbif_usageKey}`}>view on GBIF ↗</a>{g.warning?<span class="text-coral"> · ⚠ {g.warning}</span>:null}<p class="mt-2 text-xs text-slate-600">Reconciliation is reviewable only — the verbatim dataset name is preserved (docs/TAXONOMY_POLICY.md).</p></div>:null}
<h2 class="mt-10 text-2xl font-bold">Interactions</h2><div class="mt-6 grid gap-4">{related.map(i=><a class="card block text-ink hover:border-teal" href={`/MimicryDB/interactions/${i.id.replace(':','-')}/`}><div class="flex flex-wrap items-center justify-between gap-3"><div class="text-lg font-semibold">{i.mimic} <span class="text-coral">→</span> {i.model}</div><span class="pill grade-{i.evidence}"></span></div><div class="mt-2 text-sm text-slate-600">{i.id} · {i.type} · receiver: {i.receiver}</div></a>)}</div><p class="mt-8 text-sm text-slate-600">Prototype data — names are used as written in the sample records.</p></div>:<div class="container py-16"><h1 class="text-3xl font-bold">Taxon not found</h1></div>}</Layout>
